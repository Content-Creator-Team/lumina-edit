# Cutroom — environment configuration
#
# NOTHING HERE IS REQUIRED TO RUN THE PREVIEW.
#
# With no configuration the app boots into DEMO MODE: a self-contained local
# workspace with realistic fixture projects. Demo mode never calls the FastAPI
# service.
#
# Set VITE_API_URL to switch to live mode against the FastAPI backend
# (native /api/v1/auth register + login + JWT).

# --- Mode override (optional) ----------------------------------------------
# true  -> force the demo workspace even when live values are present
# false -> force the live integration (the app then reports missing config)
# unset -> automatic: live when configured, demo otherwise
# VITE_DEMO_MODE=true

# --- FastAPI backend (client-side fetch) -----------------------------------
# VITE_API_URL=http://localhost:8000

# --- Server-side API URL (TanStack Start server functions → backend) -------
# API_URL=http://localhost:8000

# --- PostHog browser analytics --------------------------------------------
# VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Optional observability links (settings page shows them only if set) ---
# VITE_GRAFANA_URL=
# VITE_POSTHOG_URL=
