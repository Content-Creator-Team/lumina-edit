# Cutroom — environment configuration
#
# NOTHING HERE IS REQUIRED TO RUN THE PREVIEW.
#
# With no configuration the app boots into DEMO MODE: a self-contained local
# workspace with realistic fixture projects (dashboard, upload simulation,
# processing pipeline, review, plans/versions, render and settings). Demo mode
# never calls Keycloak or the FastAPI service.
#
# As soon as VITE_API_URL and the three VITE_KEYCLOAK_* values below are set,
# the app automatically switches to the real integration: hosted Keycloak
# authorization-code + PKCE login, httpOnly token cookies, silent refresh and
# Bearer-authenticated calls to the FastAPI REST API.

# --- Mode override (optional) ----------------------------------------------
# true  -> force the demo workspace even when live values are present
# false -> force the live integration (the app then reports missing config)
# unset -> automatic: live when configured, demo otherwise
# VITE_DEMO_MODE=true

# --- FastAPI backend (spec name: NEXT_PUBLIC_API_URL) ----------------------
# VITE_API_URL=https://api.example.com

# --- Keycloak (hosted login, authorization code + PKCE) --------------------
# spec: NEXT_PUBLIC_KEYCLOAK_URL / _REALM / _CLIENT_ID
# VITE_KEYCLOAK_URL=https://auth.example.com
# VITE_KEYCLOAK_REALM=cutroom
# VITE_KEYCLOAK_CLIENT_ID=cutroom-web

# Server-side values used by the token-exchange server functions (never
# exposed to the browser; no VITE_ prefix).
# KEYCLOAK_URL=https://auth.example.com
# KEYCLOAK_REALM=cutroom
# KEYCLOAK_CLIENT_ID=cutroom-web
# Only needed for confidential clients; omit for public PKCE clients.
# KEYCLOAK_CLIENT_SECRET=

# --- Optional observability links (settings page shows them only if set) ---
# VITE_GRAFANA_URL=
# VITE_POSTHOG_URL=
